@model _8_ConferenceAttendanceChecking.Models.AttendeeVisit
@{
    ViewData["Title"] = "Attendee Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h4 class="mb-3">Attendee Information</h4>
            <dl class="row">
                <dt class="col-sm-4">Ticket Number</dt>
                <dd class="col-sm-8">@Model.TicketNumber</dd>

                <dt class="col-sm-4">Full Name</dt>
                <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-4">Organization</dt>
                <dd class="col-sm-8">@Model.Organization</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Contact</dt>
                <dd class="col-sm-8">@Model.ContactNumber</dd>

                <dt class="col-sm-4">Event</dt>
                <dd class="col-sm-8">@Model.EventName</dd>

                <dt class="col-sm-4">Check-In</dt>
                <dd class="col-sm-8">@Model.CheckInTime.ToString("g")</dd>

                <dt class="col-sm-4">Check-Out</dt>
                <dd class="col-sm-8">@(Model.CheckOutTime.HasValue ? Model.CheckOutTime.Value.ToString("g") : "Still Present")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>

                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "None" : Model.Notes)</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>