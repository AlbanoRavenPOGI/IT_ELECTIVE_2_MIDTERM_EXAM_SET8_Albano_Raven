<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Conference Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
            :root {
                --brand-primary: #1e293b;
                --brand-accent: #2563eb;
                --bg-main: #f8fafc;
                --card-border: #e2e8f0;
            }

            body {
                background-color: var(--bg-main);
                color: #334155;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .main-navbar {
                background-color: #ffffff;
                border-bottom: 1px solid var(--card-border);
                box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            }

            .navbar-brand {
                font-weight: 700;
                color: var(--brand-primary) !important;
                letter-spacing: -0.5px;
            }

            .nav-link {
                font-weight: 500;
                color: #64748b !important;
                transition: color 0.15s ease-in-out;
            }

                .nav-link:hover, .nav-link.active {
                    color: var(--brand-accent) !important;
                }

            .card-custom {
                background: #ffffff;
                border: 1px solid var(--card-border);
                border-radius: 10px;
                box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px 0 rgba(0, 0, 0, 0.02);
            }

            .btn-primary {
                background-color: var(--brand-accent);
                border-color: var(--brand-accent);
                font-weight: 500;
                padding: 0.5rem 1.25rem;
                border-radius: 6px;
            }

                .btn-primary:hover {
                    background-color: #1d4ed8;
                    border-color: #1d4ed8;
                }

            .footer-custom {
                margin-top: auto;
                background-color: #ffffff;
                border-top: 1px solid var(--card-border);
                padding: 1.25rem 0;
                font-size: 0.875rem;
                color: #94a3b8;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light main-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-ticket-detailed-fill text-primary"></i>
                    <span>Conference Manager</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Attendee" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Monitoring List
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-muted small me-2">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Sign Out</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container text-center">
            <span>Conference Attendee Check-In & Monitoring System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>